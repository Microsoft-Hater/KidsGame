<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="76dp"
        android:layout_marginTop="46dp"
        android:text="Guess The Number Between 1 And 30" />

    <EditText
        android:id="@+id/numberInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title"
        android:layout_alignStart="@+id/title"
        android:layout_marginStart="14dp"
        android:layout_marginTop="75dp"
        android:ems="10"
        android:hint="Your Number"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/guess"
        android:layout_width="148dp"
        android:layout_height="66dp"
        android:layout_alignStart="@+id/numberInput"
        android:layout_alignBottom="@+id/numberInput"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="-84dp"
        android:text="Guess" />

    <TextView
        android:id="@+id/noGuesses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/guess"
        android:layout_alignStart="@+id/guess"
        android:layout_marginStart="46dp"
        android:layout_marginTop="140dp" />

    <Button
        android:id="@+id/playAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/noGuesses"
        android:layout_alignStart="@+id/noGuesses"
        android:layout_marginStart="-15dp"
        android:layout_marginTop="13dp"
        android:text="Button"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title"
        android:layout_alignStart="@+id/title"
        android:layout_marginStart="91dp"
        android:layout_marginTop="25dp" />

</RelativeLayout>